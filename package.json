    "verify": "pnpm build && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "execa": "^10.0.0",
    "mdclint": "^0.1.2",
    "monaco-editor-core": "^0.56.0",
    "release-it": "^21.0.0",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
